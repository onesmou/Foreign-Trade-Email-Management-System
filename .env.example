DATA_DIR=./data
APP_URL=https://crm.example.com
# Optional: set a long random value. If omitted, the app creates data/.app-secret.
APP_SECRET=
# Set to 1 only when a custom AI service uses a private-network HTTP address.
ALLOW_LOCAL_AI=0
# Optional: required only when an email service posts inbound messages to /api/email/inbound.
INBOUND_EMAIL_SECRET=

DATA_DIR=./data
APP_URL=https://crm.example.com
# Optional: set a long random value. If omitted, the app creates data/.app-secret.
APP_SECRET=
# Required for a NEW public deployment: generate a random first-admin setup token.
# The token is not returned by any API; enter it only on /setup. Existing users are unaffected.
SETUP_TOKEN=
# Set to 1 only when a custom AI service uses a private-network HTTP address.
ALLOW_LOCAL_AI=0
# Optional: required only when an email service posts inbound messages to /api/email/inbound.
INBOUND_EMAIL_SECRET=
# WhatsApp: blank uses HTTPS_PROXY/HTTP_PROXY if already configured; "direct" forces no proxy.
# Example local desktop only: WA_PROXY_URL=http://127.0.0.1:7897
# In Docker, 127.0.0.1 means the container, not your desktop or the host.
WA_PROXY_URL=
# Required for `npm run backup`; use at least 12 characters containing letters and numbers.
BACKUP_PASSPHRASE=
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=30
# Optional: copy each encrypted backup to another disk or mounted NAS directory.
BACKUP_COPY_DIR=
